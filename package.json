{
  "name": "fleetsync",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --reset-cache",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test:android": "PLATFORM=android wdio run appium-tests/config/wdio.conf.js",
    "test:ios": "PLATFORM=ios wdio run appium-tests/config/wdio.conf.js",
    "test:web": "PLATFORM=web wdio run appium-tests/config/wdio.conf.js",
    "test:all": "npm run test:android && npm run test:ios && npm run test:web",
    "test:report": "node appium-tests/utils/generateExcelReport.js"
  },
  "dependencies": {
    "@expo/ngrok": "4.1.3",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.16.0",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.0",
    "expo": "~54.0.35",
    "expo-build-properties": "~1.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.14.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "5.6.0",
    "react-native-screens": "4.16.0"
  },
  "private": true,
  "devDependencies": {
    "@wdio/cli": "^9.30.0",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "@wdio/spec-reporter": "^9.29.1",
    "chai": "^6.2.2",
    "exceljs": "^4.4.0",
    "wdio-json-reporter": "^4.0.1"
  }
}
